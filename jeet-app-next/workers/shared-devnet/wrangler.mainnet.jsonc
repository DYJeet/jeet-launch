{
  "name": "jeet-launch-shared-mainnet",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "JEET_SHARED_PROFILE": "mainnet" },
  "alias": { "node:sqlite": "./src/sqlite-unavailable.ts" },
  "durable_objects": {
    "bindings": [{ "name": "JEET_SHARED", "class_name": "JeetSharedIndex" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["JeetSharedIndex"] }],
  "observability": { "enabled": false }
}
