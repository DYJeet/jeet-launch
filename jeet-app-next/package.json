{
  "name": "jeet-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "validator": "bash scripts/local-validator.sh",
    "custody:build": "cargo-build-sbf --manifest-path programs/launch-custody/Cargo.toml --sbf-out-dir programs/launch-custody/target/deploy -- --locked",
    "test:custody": "node scripts/run-custody-tests.mjs",
    "test:local": "node scripts/run-custody-tests.mjs",
    "fees:build:local": "cargo-build-sbf --manifest-path programs/launch-custody/Cargo.toml --sbf-out-dir programs/launch-custody/target/local-fee-test -- --locked --features local-fee-test",
    "test:fees:client": "node --test scripts/test-fee-client.mjs",
    "test:native": "cargo test --locked --manifest-path programs/launch-custody/Cargo.toml",
    "test:fees:dashboard": "node scripts/test-fee-dashboard.mjs",
    "test:market": "node scripts/run-market-tests.mjs",
    "test:market:math": "node --test scripts/test-market-math.mjs",
    "test:rpc:reads": "node --test scripts/test-rpc-reads.mjs",
    "test:v5:rising": "node --test scripts/test-v5-rising.mjs",
    "test:public:gating": "node --test scripts/test-public-gating.mjs",
    "test:v5:flexible": "node --test scripts/test-v5-flexible.mjs",
    "test:v5:local": "node scripts/run-v5-tests.mjs",
    "amm:build:local": "bash scripts/amm/build-cpmm.sh",
    "test:amm:cpmm": "node scripts/amm/run-cpmm.mjs",
    "test:graduation:local": "node scripts/amm/run-graduation.mjs",
    "test:graduation:client": "node --test scripts/test-graduation-client.mjs",
    "metadata:recover:local": "node scripts/metadata/recover-program.mjs",
    "test:metadata:client": "node --test scripts/test-metadata-client.mjs",
    "test:metadata:local": "node scripts/metadata/run-local.mjs",
    "test:creation:browser": "node scripts/test-creation-inputs.mjs",
    "test:wallet:unit": "node --test scripts/test-wallet-infrastructure.mjs",
    "test:wallet:browser": "node scripts/test-wallet-browser.mjs",
    "test:wallet:creation:browser": "node scripts/test-wallet-creation-browser.mjs",
    "test:metadata:storage": "node --test scripts/test-metadata-storage.mjs scripts/test-pinata-pipeline.mjs",
    "metadata:pinata:environment": "node scripts/check-pinata-environment.mjs",
    "metadata:pinata:verify": "node scripts/verify-pinata-live.mjs"
  },
  "dependencies": {
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.5.0",
    "@solana/kit-plugin-rpc": "0.22.0",
    "@solana/kit-plugin-signer": "0.19.0",
    "@solana/kit-plugin-wallet": "0.22.0",
    "@solana/react": "8.5.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
